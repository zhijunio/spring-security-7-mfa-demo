frontend/.eslintcache
# Front-end build output. Vite / the Angular CLI can write into Spring Boot's
# static folder during `generate-resources`; Next.js static exports are copied
# into the build output directory. Treat generated frontend files as disposable.
# The placeholder `index.html` shipped for frontend-less projects stays tracked;
# once you add a frontend/ project the build overwrites it, so add
# `/src/main/resources/static/index.html` here too if you do not want that diff.
/src/main/resources/static/assets/
/src/main/resources/static/*.js
/src/main/resources/static/*.css
/src/main/resources/static/*.map
# Testcontainers / Docker
.testcontainers.properties
**/.testcontainers/*
.docker/
*.pid
